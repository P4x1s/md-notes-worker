# 复制为 .dev.vars 后填入本地开发值；.dev.vars 已加入 .gitignore，切勿提交
# 生成随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars
# 单用户模式：登录账号即这两个值（生产环境配置在 Worker 的 Variables and Secrets）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-min-8-chars
# Turnstile：生产 site key 在 wrangler.toml [vars]，secret key 用 wrangler secret put。
# 本地开发用官方测试对（always passes）：https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
